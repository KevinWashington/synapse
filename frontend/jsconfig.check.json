{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true,
    "strict": false,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/services/api.js",
    "src/types/api.js",
    "src/features/articles/utils/reviewWorkspace.js"
  ]
}
